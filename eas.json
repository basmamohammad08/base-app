{
  "cli": { "version": ">= 18.5.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "releaseChannel": "development",
      "developmentClient": true,
      "android": { "buildType": "apk" },
      "ios": { "simulator": true },
      "env": { "NODE_ENV": "development", "EXPO_PUBLIC_CHANNEL": "development" }
    },
    "development:ipa": {
      "extends": "development",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "distribution": "internal"
    },
    "staging": {
      "releaseChannel": "staging",
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": { "NODE_ENV": "production", "EXPO_PUBLIC_CHANNEL": "staging" }
    },
    "staging:simulator": {
      "extends": "staging",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true }
    },
    "qa": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": { "NODE_ENV": "production", "EXPO_PUBLIC_CHANNEL": "qa" }
    },
    "production": {
      "releaseChannel": "production",
      "distribution": "store",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "ios": {},
      "env": { "NODE_ENV": "production", "EXPO_PUBLIC_CHANNEL": "production" }
    }
  },
  "submit": {
    "preproduction": {
      "android": { "track": "production" },
      "ios": { "ascAppId": "test", "appleTeamId": "test" }
    }
  }
}
